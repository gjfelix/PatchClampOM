within PatchClamp.Amplifiers;
model RampVoltageSource
  "Linear voltage ramp source -- sweep protocol for I-V curves"

  parameter Modelica.Units.SI.Voltage V_start = -0.100
    "Starting ramp voltage [V] (default: -100 mV)"
    annotation(Dialog(group = "Ramp protocol"));
  parameter Modelica.Units.SI.Voltage V_end   =  0.060
    "Final ramp voltage [V] (default: +60 mV)"
    annotation(Dialog(group = "Ramp protocol"));
  parameter Real t_ramp(unit = "s", min = 1.0e-6) = 0.500
    "Total ramp duration [s] (default: 500 ms)"
    annotation(Dialog(group = "Ramp protocol"));

  PatchClamp.Interfaces.ElectricalPin_p p
    "Positive terminal -- connect to the membrane's intracellular pin"
    annotation(Placement(transformation(extent = {{90, -10}, {110, 10}})));
  PatchClamp.Interfaces.ElectricalPin_n n
    "Negative terminal -- connect to the extracellular node (Ground)"
    annotation(Placement(transformation(extent = {{-110, -10}, {-90, 10}})));

  Modelica.Units.SI.Voltage V_out
    "Instantaneous output voltage, p.v - n.v [V]";

equation
  // Linear ramp, holding at V_end once complete
  V_out = V_start + (V_end - V_start) * min(time / t_ramp, 1.0);
  p.v - n.v = V_out;
  p.i + n.i = 0;

  annotation(
    Documentation(info = "<html>
      <h2>RampVoltageSource</h2>
      <p>
        Sweeps linearly from <code>V_start</code> to <code>V_end</code> over
        <code>t_ramp</code>, then holds at <code>V_end</code>.
      </p>

      <h3>Typical use with GoldmanMembrane</h3>
      <ol>
        <li>Connect <code>p</code> to <code>GoldmanMembrane.membrane_p</code>.</li>
        <li>Connect <code>n</code> to the extracellular node shared with <code>Ground.p</code>.</li>
        <li>Simulate with <code>stopTime = t_ramp</code>.</li>
        <li>Plot <code>I_total</code> vs. <code>membrane.V_m</code> for the I-V curve.</li>
        <li>The I_total = 0 crossing is the reversal potential (matches V_Goldman for K+/Na+/Cl- when P_Ca &#8776; 0).</li>
      </ol>

      <table border='1' cellpadding='4'>
        <tr><th>Parameter</th><th>Default</th></tr>
        <tr><td>V_start</td><td>-100 mV</td></tr>
        <tr><td>V_end</td>  <td>+60 mV</td></tr>
        <tr><td>t_ramp</td> <td>500 ms</td></tr>
      </table>

      <p>
        <code>VoltageClampAmplifier</code> implements a step protocol
        (holding + step); <code>RampVoltageSource</code> instead sweeps
        continuously, suited to tracing an I-V curve in a single run. On
        real hardware, the ramp is generated by the amplifier's DAC under
        control of the acquisition software.
      </p>
    </html>"),
    Icon(graphics = {
      Bitmap(
        extent = {{-100, -100}, {100, 100}},
        fileName = "modelica://PatchClamp/Icons/RampVoltageSource.png")
    })
  );
end RampVoltageSource;
