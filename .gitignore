# Archivos de usuario de OMEdit
OMEdit.ini
OMNotebook.ini
OMShell.ini
OMPlot.ini

# Archivos de sistema
.DS_Store
Thumbs.db

# Directorios de artefactos de CI
/.github/actions/install-omc/omc*
/.github/actions/install-omc/PhysioLibrary*

# Otros
*.swp
*.swo
*~

# VSCode
.vscode/

# omc-sim.sh scratch dir (headless OpenModelica simulation runs via Docker)
/.omc_runs/

# Python venv used for figure generation (matplotlib etc.)
/.venv/

# Figure-generation source is intentionally tracked despite the blanket
# *.py / *.mos ignores above (needed for paper reproducibility, Section 4.0)
!paper_figures/*.py
!paper_figures/*.mos

# Dev-tool scripts are intentionally tracked despite the blanket *.py ignore
!scripts/*.py

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Wiley journal-template assets (copyrighted, not for redistribution) and the
# LaTeX manuscript itself are kept out of the public repo for now
/WileyDesign/
/paper_latex/
